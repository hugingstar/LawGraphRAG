# Postgres
POSTGRES_USER=lawowly
POSTGRES_PASSWORD=change_me
POSTGRES_DB=lawowly
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# 법제처 Open API (https://open.law.go.kr 에서 발급)
LAW_OC_KEY=your_law_open_api_key_here

# Gemini API (https://aistudio.google.com/apikey 에서 발급)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Embedding model (local, sentence-transformers)
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIM=1024

# Neo4j (GraphRAG 지식그래프)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me

# Docker 볼륨 이름 (선택)
# 비워두면 lawgraphrag_db_data / lawgraphrag_hf_cache 로 만들어진다.
# 다른 이름의 기존 볼륨에 든 데이터를 그대로 쓰려면 여기서 지정한다.
#DB_VOLUME=lawgraphrag_db_data
#HF_VOLUME=lawgraphrag_hf_cache
