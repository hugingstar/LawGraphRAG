# cp .env.ops.example .env.ops 후 값을 채운다.
# 이 파일이 없어도 ops 는 아래 기본값으로 뜬다(docker-compose.ops.yml 의 env_file 은 required: false).
#
# 앱의 .env 와 분리한 이유: 모니터링은 읽기 전용 계정으로 붙어야 하고,
# 앱 비밀값을 바꿔도 모니터링이 같이 흔들리면 안 된다.

# --- 웹 ---
APP_URL=http://host.docker.internal:8000
APP_HEALTH_PATH=/

# --- Postgres: 읽기 전용 계정 ---
# 계정 생성:  ops/create_readonly_role.sql 참고
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5433
POSTGRES_DB=lawowly
POSTGRES_USER=lawowly_ro
POSTGRES_PASSWORD=여기에_읽기전용_비밀번호

# --- Neo4j: 전용 계정 ---
# 주의: Neo4j Community 는 RBAC(권한 제한)를 지원하지 않는다. 별도 계정을 만들어도
# 권한은 앱 계정과 동일하고, 자격증명만 분리된다. 진짜 읽기 전용은 Enterprise 전용.
#   CREATE USER ops_ro IF NOT EXISTS SET PASSWORD '...' CHANGE NOT REQUIRED
NEO4J_URI=bolt://host.docker.internal:7687
NEO4J_USER=ops_ro
NEO4J_PASSWORD=여기에_neo4j_ops_비밀번호

# --- Docker 컨테이너 감시 ---
DOCKER_ENABLED=true
# 쉼표로 나눈 조각과 이름이 부분 일치하는 컨테이너만 본다. 비우면 전체인데,
# 호스트에 남아 있는 무관한 exited 컨테이너까지 잡혀 카드가 상시 빨간색이 된다.
DOCKER_NAME_FILTER=lawgraphrag

# --- 앱 활동/트래픽 ---
# uvicorn 액세스 로그를 읽어올 앱 컨테이너 이름
APP_CONTAINER_NAME=lawgraphrag-api-1

# --- 수집 ---
POLL_INTERVAL_SECONDS=30
HISTORY_RETENTION_DAYS=7
# 3D 개요 화면이 한 번에 그리는 Law 노드 상한
GRAPH_MAX_NODES=1500

# --- postgres-exporter (docker-compose.ops.yml 에서만 사용) ---
# postgres_exporter 이미지가 직접 읽는 변수라 이름을 그대로 맞춘다.
DATA_SOURCE_NAME=postgresql://lawowly_ro:여기에_읽기전용_비밀번호@host.docker.internal:5433/lawowly?sslmode=disable

# --- Grafana ---
# 이미지가 직접 읽는 변수명(GF_ 접두사). compose 의 ${VAR} 치환이 아니라
# env_file 로 컨테이너에 직접 주입한다.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# --- Alertmanager: critical 알림을 받을 Slack Incoming Webhook ---
# Slack 앱 디렉토리 → Incoming Webhooks → 채널 선택 → Add 로 발급.
# 비워두면 라우팅·억제 규칙은 정상 동작하지만 Slack 발송만 실패한다.
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
